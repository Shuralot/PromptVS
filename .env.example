# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=tracktest
DB_PORT=5432

# URL de conexão para o Prisma
# Local: Use localhost se estiver rodando o banco via Docker mas o app via 'npm run dev'
# Docker: Use 'db' (nome do serviço no docker-compose) se estiver rodando tudo via Docker
DATABASE_URL="postgresql://postgres:password@localhost:5432/tracktest"

# -----------------------------------------------------------------------------
# SERVIÇOS DE IA
# -----------------------------------------------------------------------------
# Obtenha sua chave em: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# Evolution API (Integração com WhatsApp)
EVOLUTION_API_URL=https://your-evolution-api-url.com
EVOLUTION_API_KEY=your_evolution_key_here
EVOLUTION_INSTANCE_NAME=your_instance_name


# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO SERVIDOR DE SOCKET (Tempo Real)
# -----------------------------------------------------------------------------
# Porta onde o servidor de socket irá rodar
PORT=4000

# URL que o backend usa para notificar o servidor de socket (interno)
# Se estiver no Docker, use: http://socket-server:4000
SOCKET_SERVER_URL=http://localhost:4000

# URL que o navegador usa para se conectar ao socket (público)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO APLICATIVO (Next.js)
# -----------------------------------------------------------------------------
APP_PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DO WEBHOOK SERVICE
# -----------------------------------------------------------------------------
WEBHOOK_SERVICE_PORT=5001
MAIN_APP_URL=http://localhost:3000
INTERNAL_API_KEY=sh-secret-key-123

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO
# -----------------------------------------------------------------------------
ADMIN_PASSWORD=admin123
JWT_SECRET=super-secret-track-test-key-2026

